        "@vue/reactivity": "^3.5.0",
        "clsx": "^2.0.0",
        "dayjs": "^1.11.0",
        "framer-motion": "^11.0.0",
        "i18next": "^25.0.0",
        "idb-keyval": "^6.0.0",
        "inversify": "^7.0.0",
