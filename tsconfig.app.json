{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "noFallthroughCasesInSwitch": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "useDefineForClassFields": false,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "baseUrl": ".",
        "typeRoots": ["./src/types/@global", "./node_modules/@types"],
        "paths": {
            "$/core":          ["./src/core"],
            "$/core/*":        ["./src/core/*"],
            "$/controllers":   ["./src/controllers"],
            "$/controllers/*": ["./src/controllers/*"],
            "$/domains":       ["./src/domains"],
            "$/domains/*":     ["./src/domains/*"],
            "$/hooks":         ["./src/hooks"],
            "$/hooks/*":       ["./src/hooks/*"],
            "$/services":      ["./src/services"],
            "$/services/*":    ["./src/services/*"],
            "$/reactivity":    ["./src/reactivity"],
            "$/reactivity/*":  ["./src/reactivity/*"],
            "$/types":         ["./src/types"],
            "$/types/*":       ["./src/types/*"],
            "$/enums":         ["./src/enums"],
            "$/enums/*":       ["./src/enums/*"],
            "$/utils":         ["./src/utils"],
            "$/utils/*":       ["./src/utils/*"],
            "$/consts":        ["./src/consts"],
            "$/consts/*":      ["./src/consts/*"],
            "$/view":          ["./src/view"],
            "$/view/*":        ["./src/view/*"],
            "$/hocs":          ["./src/hocs"],
            "$/hocs/*":        ["./src/hocs/*"],
            "$/effects":       ["./src/effects"],
            "$/effects/*":     ["./src/effects/*"],
            "$/errors":        ["./src/errors"],
            "$/errors/*":      ["./src/errors/*"],
            "$/uis":           ["./src/uis"],
            "$/uis/*":         ["./src/uis/*"],
            "$/components":    ["./src/components"],
            "$/components/*":  ["./src/components/*"],
            "$/component-controllers":    ["./src/component-controllers"],
            "$/component-controllers/*":  ["./src/component-controllers/*"],
            "$/pages":         ["./src/pages"],
            "$/pages/*":       ["./src/pages/*"],
            "$/global-symbol": ["./src/types/@global-symbol"],
            "$/global-symbol/*": ["./src/types/@global-symbol/*"]
        }
    },
    "include": ["src"]
}
